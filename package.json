{
  "name": "iron-focus",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.shanto.IronFocus",
    "productName": "Iron Focus",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
      
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "executableName": "iron-focus",
      "maintainer": "Nazmul Alom Shanto <you@example.com>",
      "desktop": {
        "Name": "Iron Focus",
        "Comment": "A productivity timer app",
        "GenericName": "Focus App"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Iron Focus",
      "license": "LICENSE",
      "runAfterFinish": true
    },
    "files": [
      "**/*"
    ]
  },
  "keywords": [
    "electron",
    "productivity",
    "task-manager",
    "time-tracker",
    "focus",
    "minimal",
    "offline",
    "habit-tracker",
    "pomodoro",
    "self-improvement",
    "desktop-app",
    "ironfocus"
  ],
  "author": "Nazmul Alom Shanto",
  "license": "MIT",
  "description": "Iron Focus is a minimalist always-on-top productivity tool to help users stay committed to single tasks through a focused session workflow.",
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3"
  }
}
